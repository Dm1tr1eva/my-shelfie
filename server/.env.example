# Copy to server/.env and fill in. The real .env is never committed.

# Port Express listens on
PORT=5000

# Origin the frontend runs on. Needed for CORS to allow credentials (the
# httpOnly auth cookie) — cors() cannot combine a wildcard origin with
# Access-Control-Allow-Credentials.
CLIENT_URL=http://localhost:3000

# Set to "production" on the host. Turns on the Secure flag of the session
# cookie, which a plain-HTTP localhost cannot use, so leave it unset locally.
# NODE_ENV=production

# MongoDB Atlas connection string, with the database name in the path
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/my-shelfie?appName=Cluster0

# Secret used to sign JWTs. Any long random string.
JWT_SECRET=<random string>

# Google Books API key, for book search. Server-side only: this repository is
# public and the terms forbid publishing credentials. Restrict the key to the
# Books API in the Google Cloud console.
GOOGLE_BOOKS_API_KEY=<api key>

# Optional. The database `npm run verify` runs against; the tests clear every
# collection in it. When unset, the name is taken from MONGODB_URI with a
# "-test" suffix (my-shelfie-test). The helper refuses a value that resolves to
# the development database.
# MONGODB_URI_TEST=
