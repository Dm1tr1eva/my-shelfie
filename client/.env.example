# Copy to client/.env.local and fill in. Not committed (client/.gitignore: .env*).

# Origin of the backend API, no trailing slash. Server-side only: next.config.ts
# proxies /api/* to it, so the browser only ever talks to the Next.js origin.
# Optional locally (defaults to http://localhost:5000). On Vercel it must be set
# before the build, because the rewrite destination is baked in at build time.
API_ORIGIN=http://localhost:5000
